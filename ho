#!/bin/sh
# Launcher for ho.py on POSIX shells: uses the first Python >= 3.10 it finds.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 &&
     "$py" -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
    exec "$py" "$dir/ho.py" "$@"
  fi
done
echo "ho: Python 3.10+ not found (tried python3, python)" >&2
exit 1
